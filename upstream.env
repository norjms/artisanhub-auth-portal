# The Authelia release the sign-in portal is built from, and the artisanhub-ui release that supplies its look.
# Only releases are taken (never a branch or a nightly). .github/workflows/upstream-watch.yml moves the Authelia
# lines together when a new release is published; AUTHELIA_IMAGE is that release's official image, whose files
# (everything but the binary) the image keeps.
AUTHELIA_REPO=https://github.com/authelia/authelia.git
AUTHELIA_VERSION=v4.39.28
AUTHELIA_COMMIT=8da42b2348b0351c6284a2940a9c5eec3d4cd3fd
AUTHELIA_IMAGE=authelia/authelia:4.39.28@sha256:bd97cff4fcbf715b5ff1f9ae286afbe6033afce385302520b0368122d43a6f54
ARTISANHUB_UI_REPO=https://github.com/norjms/artisanhub-ui.git
ARTISANHUB_UI_VERSION=v0.1.0
ARTISANHUB_UI_COMMIT=f16a4b9596a39324a8c0530cbb6adfb293b13aef
